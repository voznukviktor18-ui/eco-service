const SHEET_DRIVERS = "Сотрудники";
const SHEET_ACTIVE = "Активные смены";
const SHEET_HISTORY = "История смен";

function doGet(e) {
  const action = e.parameter.action;
  const id = e.parameter.id;
  const pin = e.parameter.pin;

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  if (action == "getDrivers") {
    const sheet = ss.getSheetByName(SHEET_DRIVERS);
    const data = sheet.getRange(2,1,sheet.getLastRow()-1,2).getValues();
    const drivers = data.map(r => ({id: r[0], name: r[1]}));
    return ContentService.createTextOutput(JSON.stringify({success:true, data: drivers}));
  }

  if (action == "auth") {
    const sheet = ss.getSheetByName(SHEET_DRIVERS);
    const data = sheet.getRange(2,1,sheet.getLastRow()-1,3).getValues(); // ID, Name, PIN
    const found = data.find(r => r[0]==id && r[2]==pin);
    return ContentService.createTextOutput(JSON.stringify({success: !!found}));
  }

  if (action == "start") {
    const sheet = ss.getSheetByName(SHEET_ACTIVE);
    const now = new Date();
    sheet.appendRow([id, now]);
    return ContentService.createTextOutput(JSON.stringify({success:true, data:{startTime: now}}));
  }

  if (action == "end") {
    const activeSheet = ss.getSheetByName(SHEET_ACTIVE);
    const historySheet = ss.getSheetByName(SHEET_HISTORY);
    const rows = activeSheet.getDataRange().getValues();
    const rowIndex = rows.findIndex(r => r[0]==id);
    if(rowIndex == -1) return ContentService.createTextOutput(JSON.stringify({success:false, error:"Смена не найдена"}));

    const startTime = rows[rowIndex][1];
    const endTime = new Date();
    const diffMs = endTime - new Date(startTime);
    const hours = Math.floor(diffMs / 1000 / 60 / 60); // округление вниз

    historySheet.appendRow([id, startTime, endTime, hours]);
    activeSheet.deleteRow(rowIndex+1); // +1 т.к. в Google Sheets строки начинаются с 1

    return ContentService.createTextOutput(JSON.stringify({success:true, data:{hours: hours}}));
  }

  return ContentService.createTextOutput(JSON.stringify({success:false, error:"Неизвестное действие"}));
}
